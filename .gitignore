# Node / Electron artifacts
node_modules/
dist/
*.log
.DS_Store
Thumbs.db

# Build cache
.cache/
_electron/.cache/

# IDE / tools
.vscode/
.playwright-mcp/

# Claude Code: commit shared settings/hooks/agents/skills, ignore personal/local state
.claude/settings.local.json
.claude/sessions/
.claude/cache/
.claude/**/__pycache__/
.claude/**/*.pyc

# Test artifacts
titlebar-test.png

# Screenshots & visual checks
screenshots/
*.png
!build/icon.png

# Эталоны визуальной регрессии НЕ в репозитории: это 30 PNG на 8.6 МБ, и каждая
# визуальная правка добавляла бы новую порцию в историю навсегда. Снимаются
# локально одной командой, когда нужны:
#   npm run screenshot && npm run visual:baseline   # принять текущий вид
#   npm run visual:check                            # сверить после правок
# На CI-раннере они всё равно не годятся: сняты на macOS, ubuntu рисует иначе.
tests/visual-baseline/

# Playwright artifacts (trace/screenshots от упавших e2e)
test-results/
playwright-report/

# Visual-audit / metrics outputs (generated by scripts/visual-audit.js)
artifacts/

# Coverage reports (npm run coverage → c8)
coverage/

# Superpowers brainstorm sessions
.superpowers/
