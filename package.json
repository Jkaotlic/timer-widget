{
  "name": "timer-widget",
  "version": "2.9.0",
  "description": "Прозрачный таймер-виджет для рабочего стола",
  "main": "electron-main.js",
  "scripts": {
    "start": "node scripts/run-electron.js",
    "dev": "node scripts/run-electron.js --dev",
    "screenshot": "node scripts/run-electron.js --screenshot",
    "test": "node --test",
    "coverage": "npx --yes c8 --reporter=text --reporter=html node --test",
    "lint": "npx eslint .",
    "ci": "npm run lint && npm test",
    "test:e2e": "npx playwright test",
    "visual:audit": "node scripts/visual-audit.js",
    "visual:baseline": "node scripts/visual-baseline.js",
    "visual:check": "node scripts/run-electron.js --screenshot --visual-check",
    "sbom": "npx --yes @cyclonedx/cyclonedx-npm --output-file sbom.json --output-format json --spec-version 1.5",
    "notice": "node scripts/generate-notice.js",
    "csp:hash": "node scripts/csp-hash.js",
    "build": "npx --yes electron-builder",
    "build:win": "npx --yes electron-builder --win",
    "build:mac": "npx --yes electron-builder --mac",
    "build:all": "npx --yes electron-builder --win --mac",
    "pack": "npx --yes electron-builder --dir"
  },
  "keywords": [
    "timer",
    "widget",
    "overlay",
    "transparent"
  ],
  "author": {
    "name": "Jkaotlic",
    "email": "jkaotlic@users.noreply.github.com"
  },
  "license": "MIT",
  "comment:overrides": "brace-expansion <=5.0.8 has a high-severity DoS advisory (GHSA-rgw5-rvv9-x895) that bypasses the earlier CVE-2026-14257 mitigation; it supersedes the two ReDoS/OOM advisories this override was originally written for (GHSA-3jxr-9vmj-r5cp, GHSA-mh99-v99m-4gvg). 5.0.9 is the patched release. The override is still load-bearing and must NOT be dropped as 'probably fixed upstream': the consumers in this tree ask for ^1.1.7 / ^2.0.1 / ^2.0.2 / ^5.0.5 (minimatch under glob, asar, universal, dir-compare, filelist), so without the pin npm resolves vulnerable 1.x and 2.x copies alongside the patched one. It reaches us purely through the electron-builder dev toolchain, never through app runtime code — 'npm audit --omit=dev' is clean either way. 5.0.9 ships dual CJS+ESM exports, so the CJS consumers keep working. @xmldom/xmldom ^0.8.15 (8 advisories incl. GHSA-6gmq-8vp8-gcm6, under plist), fast-uri ^3.1.8 (SSRF/host confusion GHSA-f65p-4m7j-42xc and 3 more, under ajv) and js-yaml ^4.3.2 (GHSA-2883-xcg3-v3hh) are pinned the same way: all three reach us only through the electron-builder toolchain, but an acceptance scanner reads package-lock/SBOM and flags them regardless. Each pin stays inside the major the consumer asks for — plist 3.x breaks on xmldom 0.9 (mimeType became mandatory).",
  "overrides": {
    "brace-expansion": "^5.0.9",
    "@xmldom/xmldom": "^0.8.15",
    "fast-uri": "^3.1.8",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-plugin-html": "^8.2.1",
    "globals": "^17.12.0"
  },
  "build": {
    "appId": "com.timer.widget",
    "productName": "TimerWidget",
    "afterPack": "build/after-pack.js",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "include": "build/nsis-include.nsh",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-Portable.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "${productName}"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "deb": {
      "fpm": [
        "--deb-no-default-config-files"
      ],
      "afterInstall": "build/linux-after-install.sh",
      "afterRemove": "build/linux-post-remove.sh"
    },
    "publish": null,
    "extraResources": [
      "build/icon.png"
    ],
    "files": [
      "electron-main.js",
      "timer-engine.js",
      "timer-controller.js",
      "recovery.js",
      "event-overrun-store.js",
      "preload.js",
      "ipc-compat.js",
      "security.js",
      "renderer-storage.js",
      "utils.js",
      "constants.js",
      "color-utils.js",
      "renderer-shared.js",
      "money-meter.js",
      "event-report.js",
      "navigation-guard.js",
      "drop-guard.js",
      "settings-schema.js",
      "clock-settings-schema.js",
      "ui-theme.js",
      "ui-lock.js",
      "panel-titlebar.js",
      "presets.js",
      "panel-presets.js",
      "panel-compact.js",
      "flip-card.js",
      "window-geometry.js",
      "digits-style.js",
      "font-select.js",
      "sound-bank.js",
      "sound-presets.js",
      "ui-feedback.js",
      "scale-input.js",
      "scale-report.js",
      "color-picker.js",
      "modal-manager.js",
      "shortcuts-help.js",
      "onboarding.js",
      "mini-bar.js",
      "panel-state.js",
      "custom-sounds.js",
      "local-background.js",
      "theme-grid.js",
      "panel-colors.js",
      "panel-display.js",
      "panel-drawer.js",
      "display-layouts.js",
      "hero-modes.js",
      "panel-reset.js",
      "electron-widget.html",
      "electron-control.html",
      "electron-clock-widget.html",
      "fonts.css",
      "design-tokens.css",
      "control.css",
      "flip-card.css",
      "surface-tones.css",
      "display.css",
      "display.html",
      "display-script.js",
      "sounds/**/*",
      "fonts/**/*",
      "NOTICE"
    ]
  },
  "dependencies": {
    "electron-log": "^5.4.4"
  }
}
